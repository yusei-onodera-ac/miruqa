# OrcaRouter（必須。LLM呼び出しはすべてここ経由）。値は絶対にコミットしない
ORCAROUTER_API_KEY=

# アプリはモデルIDをコードに固定しない。
# 観察中は orcarouter/auto、無料で試すなら orcarouter/free、固定後は Named Router 名（例: orcarouter/site-inspector）
ORCA_MODEL=orcarouter/auto

# 診断を許可するホスト（カンマ区切り）。自作デモと自分たちのサイトだけ。他社サイトは入れない
# 8765=デモサイト（EC）、8766=デモサイト2（ログインあり、社内備品貸出予約）
ALLOWED_HOSTS=127.0.0.1:8765,127.0.0.1:8766

# L4（能動テスト）を有効にするか。テスト環境のときだけ 1。既定は 0（OFF）
TEST_MODE=0

# Firewall評価API用キー（使える場合のみ）
ORCA_FIREWALL_KEY=

# v0.6 P1/P2: Java層とワーカー間の共有秘密。生成方法: openssl rand -hex 32
# Java側は web/src/main/resources/application.properties の worker.shared-secret
# （環境変数 WORKER_SHARED_SECRET）に同じ値を設定する。
# フェイルクローズド: 空のまま起動するとワーカーは起動を拒否する（開発時のレビューで指摘・修正）。
# 開発用途に限り、下のWORKER_AUTH_DISABLED=1を明示したときだけ無認証起動を許す(警告ログが出る)。
WORKER_SHARED_SECRET=
WORKER_AUTH_DISABLED=0

# コスト上限（1件=run/plan/spec単位あたり／1日あたり。USD）。超えたらLLM呼び出しを止め、
# 部分結果のまま穏やかに終了する。実測は runs/ledger.jsonl（python -m agent.cost_report で集計）
LLM_BUDGET_PER_RUN_USD=0.5
LLM_BUDGET_PER_DAY_USD=2.0

# v0.7 P5: ログインが必要な画面の点検で使う、テスト用アカウントの暗号化鍵（Java層のみ）。
# 生成方法: openssl rand -base64 32
# フェイルクローズド: 空のままだと、テスト用アカウントの登録・診断への利用ができない
# （エラーにはなるが、他の機能には影響しない）。値を変えると、既に保存済みのパスワードは
# 復号できなくなる（ローテーションの仕組みは無い。設計上の既知の割り切り）。
CREDENTIAL_ENCRYPTION_KEY=
